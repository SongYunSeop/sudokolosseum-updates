{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/(android|ios)/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/verification/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/bundles/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
